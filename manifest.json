{
  "manifest_version": 3,
  "name": "PostLab",
  "version": "1.0.0",
  "description": "PostLab Public Release 1.0.0",
  "permissions": ["sidePanel", "storage", "tabs", "alarms", "scripting", "windows"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PostLab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel-v2.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ticketlink.co.kr/*",
        "https://facility.ticketlink.co.kr/*",
        "https://*.ticketlink.co.kr/*"
      ],
      "js": ["content.js", "content-exp.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
